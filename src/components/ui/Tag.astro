---
/**
 * Display wrapper: product tone → cds-tag.
 * Tones include teal/cyan for edge badges and summary chips.
 */
export type TagTone =
	| 'default'
	| 'success'
	| 'warning'
	| 'danger'
	| 'info'
	| 'neutral'
	| 'accent'
	| 'highlight'
	| 'teal'
	| 'cyan'
	| 'magenta'
	| 'purple'
	| 'blue'
	| 'green'
	| 'gray'
	| 'cool-gray'
	| 'warm-gray'
	| 'red';

type Props = {
	tone?: TagTone;
	size?: 'sm' | 'md' | 'lg';
	class?: string;
	title?: string;
};

const { tone = 'default', size = 'sm', class: className, title } = Astro.props;

const type =
	tone === 'success' || tone === 'green'
		? 'green'
		: tone === 'warning' || tone === 'warm-gray'
			? 'warm-gray'
			: tone === 'danger' || tone === 'red'
				? 'red'
				: tone === 'info' || tone === 'highlight' || tone === 'blue'
					? 'blue'
					: tone === 'neutral' || tone === 'gray' || tone === 'default'
						? 'gray'
						: tone === 'accent' || tone === 'purple'
							? 'purple'
							: tone === 'teal'
								? 'teal'
								: tone === 'cyan'
									? 'cyan'
									: tone === 'magenta'
										? 'magenta'
										: tone === 'cool-gray'
											? 'cool-gray'
											: 'gray';
---

<cds-tag type={type} size={size} class:list={['ui-tag', className]} title={title}>
	<slot />
</cds-tag>
