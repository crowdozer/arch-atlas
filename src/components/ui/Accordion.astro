---
/**
 * Display wrapper: Arch Atlas Accordion → cds-accordion.
 * Pages never import raw cds-*.
 */
type Size = 'sm' | 'md' | 'lg';
type Alignment = 'start' | 'end';

type Props = {
	id?: string;
	size?: Size;
	alignment?: Alignment;
	disabled?: boolean;
	class?: string;
	[key: string]: unknown;
};

const {
	id,
	size = 'md',
	alignment = 'end',
	disabled = false,
	class: className,
	...rest
} = Astro.props;
---

<cds-accordion
	id={id}
	size={size}
	alignment={alignment}
	disabled={disabled || undefined}
	class={className}
	{...rest}
>
	<slot />
</cds-accordion>
