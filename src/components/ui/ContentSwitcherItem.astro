---
/**
 * Display wrapper: Arch Atlas ContentSwitcherItem → cds-content-switcher-item.
 * Pages never import raw cds-*.
 */
type Props = {
	value: string;
	name?: string;
	disabled?: boolean;
	selected?: boolean;
	class?: string;
	[key: string]: unknown;
};

const {
	value,
	name,
	disabled = false,
	selected = false,
	class: className,
	...rest
} = Astro.props;
---

<cds-content-switcher-item
	value={value}
	name={name}
	disabled={disabled || undefined}
	selected={selected || undefined}
	class={className}
	{...rest}
>
	<slot />
</cds-content-switcher-item>
