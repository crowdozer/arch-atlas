---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import Checkbox from '../components/ui/Checkbox.astro';
import Search from '../components/ui/Search.astro';
import Accordion from '../components/ui/Accordion.astro';
import AccordionItem from '../components/ui/AccordionItem.astro';
import Dropdown from '../components/ui/Dropdown.astro';
import DropdownItem from '../components/ui/DropdownItem.astro';
import ContentSwitcher from '../components/ui/ContentSwitcher.astro';
import ContentSwitcherItem from '../components/ui/ContentSwitcherItem.astro';
import Modal from '../components/ui/Modal.astro';
import ModalHeader from '../components/ui/ModalHeader.astro';
import ModalCloseButton from '../components/ui/ModalCloseButton.astro';
import ModalLabel from '../components/ui/ModalLabel.astro';
import ModalHeading from '../components/ui/ModalHeading.astro';
import ModalBody from '../components/ui/ModalBody.astro';
import ModalFooter from '../components/ui/ModalFooter.astro';
import ModalFooterButton from '../components/ui/ModalFooterButton.astro';
import FileUploader from '../components/ui/FileUploader.astro';
import FileUploaderDropContainer from '../components/ui/FileUploaderDropContainer.astro';
import Tag from '../components/ui/Tag.astro';
---

<Layout title="Arch Atlas">
	<div id="atlas-app" class="flex min-h-0 flex-1 flex-col">
		<!-- Upload (centered, only before session) -->
		<section id="atlas-upload" class="mx-auto w-full max-w-2xl flex-1 px-4 py-10 sm:px-6">
			<h1 class="mb-2 text-2xl font-semibold tracking-tight text-zinc-50">
				Upload a repository
			</h1>
			<p class="mb-4 text-sm text-zinc-400">
				Drop a ZIP of your codebase. Analysis stays local — no remote uploads.
			</p>
			<div class="atlas-lang-row mb-6" aria-label="Supported languages">
				<span class="atlas-lang-row__label">Supported languages</span>
				<div class="atlas-lang-row__chips">
					<Tag tone="teal" size="sm">TypeScript</Tag>
					<Tag tone="teal" size="sm">JavaScript</Tag>
					<Tag tone="teal" size="sm">TSX</Tag>
					<Tag tone="teal" size="sm">JSX</Tag>
				</div>
			</div>

			<div class="atlas-drop-host">
				<FileUploader class="atlas-file-uploader" labelTitle="Repository ZIP">
					<FileUploaderDropContainer
						id="atlas-drop"
						class="atlas-file-drop"
						accept=".zip,application/zip"
						name="atlas-zip"
					>
						Drop a .zip here or click to choose
					</FileUploaderDropContainer>
				</FileUploader>
			</div>

			<div class="atlas-demo mt-6">
				<p class="atlas-section-label mb-3">Or load a built-in demo</p>
				<div class="atlas-demo__grid">
					<button
						type="button"
						id="atlas-demo-react-simple"
						class="atlas-demo__card"
						data-demo="react-simple"
					>
						<span class="atlas-demo__inner">
							<span class="atlas-demo__heading">
								<span class="atlas-demo__title">React app</span>
								<Tag tone="teal" size="sm">Low complexity</Tag>
							</span>
							<span class="atlas-demo__blurb">
								Vite + React Router: pages, hooks, api, shared lib. Clean layers.
							</span>
						</span>
					</button>
					<button
						type="button"
						id="atlas-demo-next-complex"
						class="atlas-demo__card"
						data-demo="next-complex"
					>
						<span class="atlas-demo__inner">
							<span class="atlas-demo__heading">
								<span class="atlas-demo__title">Next.js app</span>
								<Tag tone="yellow" size="sm">High complexity</Tag>
							</span>
							<span class="atlas-demo__blurb">
								App Router, APIs, services, DB/Redis/Stripe, legacy pages.
							</span>
						</span>
					</button>
				</div>
			</div>

			<div class="atlas-persist mt-4">
				<Checkbox
					id="atlas-persist"
					checked={true}
					labelText="Remember this project in the browser"
					helper-text="Saves the indexed files to localStorage so a refresh or dev reload keeps your session. Stays on this device only."
					class="atlas-persist"
				/>
			</div>
			<p id="atlas-upload-status" class="mt-3 text-sm text-zinc-500" role="status"></p>
			<div id="atlas-warnings" class="mt-2 space-y-2"></div>
		</section>

		<!-- Workspace: left drawer + full-bleed alluvial -->
		<section id="atlas-workspace" class="atlas-workspace hidden min-h-0 flex-1">
			<aside id="atlas-drawer" class="atlas-drawer" aria-label="Repository explorer">
				<!-- Tree panel -->
				<div class="atlas-drawer__panel atlas-drawer__panel--tree">
					<div class="atlas-drawer__head">
						<div class="ui-tile__label mb-0">Repository tree</div>
						<p class="mt-1 text-[0.7rem] leading-snug text-zinc-500">
							Folders expand · click a source file as start
						</p>
					</div>
					<div class="atlas-drawer__tools">
						<Search
							id="atlas-tree-filter"
							size="sm"
							labelText="Filter paths"
							placeholder="Filter paths…"
							class="atlas-tree-search"
						/>
					</div>
					<div id="atlas-tree" class="atlas-tree" role="tree"></div>
				</div>

				<!-- Catalog panel (Carbon accordion sections) -->
				<div class="atlas-drawer__panel atlas-drawer__panel--catalog">
					<div class="atlas-drawer__head">
						<div class="ui-tile__label mb-0">Map catalog</div>
						<p id="atlas-catalog-summary" class="mt-1 text-[0.7rem] leading-snug text-zinc-500"></p>
					</div>
					<div class="atlas-drawer__scroll atlas-catalog">
						<Accordion
							id="atlas-catalog-accordion"
							class="atlas-catalog-accordion"
							size="sm"
							alignment="start"
						>
							<AccordionItem
								id="atlas-acc-hotspots"
								class="atlas-catalog-acc-item"
								title="High edges"
							>
								<p class="atlas-catalog-hint">
									Most connected files (in + out import edges).
								</p>
								<div id="atlas-hotspots"></div>
							</AccordionItem>
							<AccordionItem
								id="atlas-acc-complex"
								class="atlas-catalog-acc-item"
								title="Tree complexity"
							>
								<p class="atlas-catalog-hint">
									Heaviest outbound trees — all downwind import edges (files +
									packages). start→page→pkg counts as 2. Opens multi-stage hop map.
								</p>
								<div id="atlas-complex"></div>
							</AccordionItem>
							<AccordionItem
								id="atlas-acc-deepest"
								class="atlas-catalog-acc-item"
								title="Tree depth"
							>
								<p class="atlas-catalog-hint">
									Deepest outbound chains (most hops) — multi-stage map of the
									longest file→file path into packages.
								</p>
								<div id="atlas-deepest"></div>
							</AccordionItem>
							<AccordionItem
								id="atlas-acc-views"
								class="atlas-catalog-acc-item"
								title="Suggested views"
							>
								<div id="atlas-views"></div>
							</AccordionItem>
							<AccordionItem
								id="atlas-acc-starts"
								class="atlas-catalog-acc-item"
								title="Starts"
							>
								<p class="atlas-catalog-hint">Inferred entry points</p>
								<div id="atlas-starts"></div>
							</AccordionItem>
							<AccordionItem
								id="atlas-acc-ends"
								class="atlas-catalog-acc-item"
								title="Ends"
							>
								<p class="atlas-catalog-hint">Packages & sinks · click to reverse fan-in</p>
								<div id="atlas-ends"></div>
							</AccordionItem>
						</Accordion>
					</div>
				</div>
			</aside>

			<section class="atlas-stage" aria-label="Alluvial projection">
				<div class="atlas-stage__bar">
					<div class="min-w-0 flex flex-1 items-center gap-3">
						<Button
							id="atlas-alluvial-back"
							variant="ghost"
							size="sm"
							type="button"
							class="atlas-alluvial-back hidden shrink-0"
							aria-label="Back to previous alluvial view"
						>
							← Back
						</Button>
						<div class="min-w-0">
							<div class="ui-tile__label mb-0">Alluvial projection</div>
							<p id="atlas-alluvial-caption" class="truncate text-sm text-zinc-400">
								Select a start to project modules → code.
							</p>
						</div>
					</div>
					<div class="atlas-stage__controls">
						<div class="atlas-stage__control-group">
							<span class="atlas-stage__control-label" id="atlas-weight-label">Weight</span>
							<Dropdown
								id="atlas-weight-axis"
								class="atlas-stage__weight"
								size="sm"
								hideLabel
								labelText="Weight"
								titleText="Weight"
								value="import-edges"
								aria-labelledby="atlas-weight-label"
							>
								<DropdownItem value="import-edges">Import edges</DropdownItem>
								<DropdownItem value="importer-loc">Importer lines of code</DropdownItem>
								<DropdownItem value="target-loc">Imported file lines (estimate)</DropdownItem>
							</Dropdown>
						</div>
						<div class="atlas-stage__control-group">
							<span class="atlas-stage__control-label" id="atlas-precision-label"
								>Precision</span
							>
							<Dropdown
								id="atlas-loc-precision"
								class="atlas-stage__precision"
								size="sm"
								hideLabel
								labelText="Precision"
								titleText="Imported LOC precision"
								value="estimate"
								aria-labelledby="atlas-precision-label"
							>
								<DropdownItem value="estimate">Estimate</DropdownItem>
								<DropdownItem value="exact">Exact (LSP)</DropdownItem>
							</Dropdown>
						</div>
						<ContentSwitcher
							id="atlas-interaction-mode"
							class="atlas-stage__mode"
							size="sm"
							value="drill"
							aria-label="Click mode"
						>
							<ContentSwitcherItem value="drill" name="atlas-mode">Drill</ContentSwitcherItem>
							<ContentSwitcherItem value="inspect" name="atlas-mode">Inspect</ContentSwitcherItem>
						</ContentSwitcher>
					</div>
				</div>
				<div
					id="atlas-alluvial"
					class="ui-carbon-chart atlas-stage__chart"
					data-carbon-chart="alluvial"
				>
					<!-- holder recreated on each mount (Carbon Charts destroy/reuse safety) -->
				</div>
			</section>
		</section>
	</div>

	<Modal id="atlas-inspect-modal" class="atlas-inspect-modal" size="lg" aria-label="Import evidence">
		<ModalHeader class="atlas-inspect-modal__header">
			<ModalCloseButton />
			<ModalLabel id="atlas-inspect-label">Import evidence · estimate</ModalLabel>
			<ModalHeading id="atlas-inspect-heading">Import evidence</ModalHeading>
		</ModalHeader>
		<ModalBody class="atlas-inspect-modal__body">
			<div id="atlas-inspect-body" class="atlas-inspect"></div>
		</ModalBody>
		<ModalFooter>
			<ModalFooterButton kind="primary" data-modal-primary-focus id="atlas-inspect-close">
				Close
			</ModalFooterButton>
		</ModalFooter>
	</Modal>

	<script>
		import '../client/app.ts';
	</script>
</Layout>
