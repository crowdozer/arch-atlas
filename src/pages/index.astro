---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Arch Atlas">
	<div id="atlas-app" class="space-y-6">
		<section id="atlas-upload" class="mx-auto max-w-2xl">
			<p class="atlas-eyebrow mb-2">Level-1 index</p>
			<h1 class="mb-2 text-2xl font-semibold tracking-tight text-zinc-50">
				Upload a repository
			</h1>
			<p class="mb-6 text-sm text-zinc-400">
				Drop a ZIP of TypeScript or JavaScript. Parsing stays in your browser — no source
				upload. You get a file tree, suggested alluvial starts/ends, and an import-surface map.
			</p>
			<div id="atlas-drop" class="atlas-drop" data-atlas-drop>
				<p class="mb-1 text-sm font-medium text-zinc-200">Drop a .zip here</p>
				<p class="mb-4 text-xs text-zinc-500">or choose a file — .ts / .js projects</p>
				<label class="inline-flex cursor-pointer">
					<span
						class="rounded bg-teal-700 px-3 py-2 text-sm font-medium text-teal-50 hover:bg-teal-600"
					>
						Choose ZIP
					</span>
					<input id="atlas-file" type="file" accept=".zip,application/zip" />
				</label>
			</div>
			<p id="atlas-status" class="mt-3 text-sm text-zinc-500" role="status"></p>
			<div id="atlas-warnings" class="mt-2 space-y-2"></div>
		</section>

		<section id="atlas-workspace" class="hidden">
			<div class="mb-4 flex flex-wrap items-center gap-3">
				<p class="atlas-eyebrow">Workspace</p>
				<div id="atlas-summary-tags" class="flex flex-wrap gap-2"></div>
				<button
					type="button"
					id="atlas-reset"
					class="ml-auto rounded border border-zinc-700 px-2 py-1 text-xs text-zinc-400 hover:border-teal-500 hover:text-teal-300"
				>
					Clear session
				</button>
			</div>

			<div class="grid gap-4 lg:grid-cols-12">
				<!-- File tree -->
				<aside class="ui-tile ui-tile--padding-md lg:col-span-3">
					<div class="ui-tile__label">Repository tree</div>
					<p class="mb-2 text-xs text-zinc-500">
						Click a source file to use it as an alluvial start.
					</p>
					<input
						id="atlas-tree-filter"
						type="search"
						placeholder="Filter paths…"
						class="mb-2 w-full rounded border border-zinc-700 bg-zinc-950 px-2 py-1.5 text-sm text-zinc-200 placeholder:text-zinc-600 focus:border-teal-500 focus:outline-none"
					/>
					<div id="atlas-tree" class="atlas-tree"></div>
				</aside>

				<!-- Catalog -->
				<section class="ui-tile ui-tile--padding-md lg:col-span-4">
					<div class="ui-tile__label">Map catalog</div>
					<p id="atlas-catalog-summary" class="mb-3 text-sm text-zinc-400"></p>

					<h2 class="mb-2 text-xs font-semibold uppercase tracking-wide text-zinc-500">
						Suggested views
					</h2>
					<div id="atlas-views" class="mb-4"></div>

					<h2 class="mb-2 text-xs font-semibold uppercase tracking-wide text-zinc-500">
						Starts
						<span class="font-normal normal-case tracking-normal text-zinc-600">
							· inferred
						</span>
					</h2>
					<div id="atlas-starts" class="mb-4 max-h-48 overflow-auto"></div>

					<h2 class="mb-2 text-xs font-semibold uppercase tracking-wide text-zinc-500">
						Ends
						<span class="font-normal normal-case tracking-normal text-zinc-600">
							· packages & sinks
						</span>
					</h2>
					<div id="atlas-ends" class="max-h-48 overflow-auto"></div>
				</section>

				<!-- Alluvial -->
				<section class="ui-tile ui-tile--padding-md lg:col-span-5">
					<div class="flex items-start justify-between gap-2">
						<div>
							<div class="ui-tile__label">Alluvial projection</div>
							<p id="atlas-alluvial-caption" class="text-sm text-zinc-400">
								Select a start to project import flow.
							</p>
						</div>
						<span
							id="atlas-epistemic"
							class="shrink-0 rounded bg-zinc-800 px-2 py-0.5 text-[0.65rem] uppercase tracking-wide text-zinc-400"
						>
							Observed edges
						</span>
					</div>
					<div
						id="atlas-alluvial"
						class="ui-carbon-chart mt-3"
						data-carbon-chart="alluvial"
					>
						<div
							class="ui-carbon-chart__holder"
							data-carbon-chart-holder
						>
							<p class="ui-carbon-chart__loading">No projection yet.</p>
						</div>
					</div>
				</section>
			</div>
		</section>
	</div>

	<script>
		import '../client/app.ts';
	</script>
</Layout>
