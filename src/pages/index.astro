---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Arch Atlas">
	<div id="atlas-app" class="flex min-h-0 flex-1 flex-col">
		<!-- Upload (centered, only before session) -->
		<section id="atlas-upload" class="mx-auto w-full max-w-2xl flex-1 px-4 py-10 sm:px-6">
			<p class="atlas-eyebrow mb-2">Level-1 index</p>
			<h1 class="mb-2 text-2xl font-semibold tracking-tight text-zinc-50">
				Upload a repository
			</h1>
			<p class="mb-6 text-sm text-zinc-400">
				Drop a ZIP of TypeScript or JavaScript. Parsing stays in your browser — no source
				upload. You get a file tree, suggested alluvial starts/ends, and an import-surface map.
			</p>
			<div id="atlas-drop" class="atlas-drop" data-atlas-drop>
				<p class="mb-1 text-sm font-medium text-zinc-200">Drop a .zip here</p>
				<p class="mb-4 text-xs text-zinc-500">or choose a file — .ts / .js projects</p>
				<label class="inline-flex cursor-pointer">
					<span
						class="rounded bg-teal-700 px-3 py-2 text-sm font-medium text-teal-50 hover:bg-teal-600"
					>
						Choose ZIP
					</span>
					<input id="atlas-file" type="file" accept=".zip,application/zip" />
				</label>
			</div>

			<div class="atlas-demo mt-6">
				<p class="atlas-section-label mb-2">Or load a built-in demo</p>
				<p class="mb-3 text-xs text-zinc-500">
					Reproducible fixtures for feedback — written into the session like a ZIP, no
					upload needed.
				</p>
				<div class="atlas-demo__grid">
					<button
						type="button"
						id="atlas-demo-react-simple"
						class="atlas-demo__card"
						data-demo="react-simple"
					>
						<span class="atlas-demo__tag">Low complexity</span>
						<span class="atlas-demo__title">React app</span>
						<span class="atlas-demo__blurb">
							Vite + React Router: pages, hooks, api, shared lib. Clean layers.
						</span>
					</button>
					<button
						type="button"
						id="atlas-demo-next-complex"
						class="atlas-demo__card"
						data-demo="next-complex"
					>
						<span class="atlas-demo__tag atlas-demo__tag--high">High complexity</span>
						<span class="atlas-demo__title">Next.js app</span>
						<span class="atlas-demo__blurb">
							App Router, APIs, services, DB/Redis/Stripe, legacy pages — spaghetti OK.
						</span>
					</button>
				</div>
			</div>

			<label class="atlas-persist mt-4 flex cursor-pointer items-start gap-2.5">
				<input
					id="atlas-persist"
					type="checkbox"
					class="atlas-persist__input mt-0.5"
					checked
				/>
				<span class="min-w-0">
					<span class="block text-sm font-medium text-zinc-200">
						Remember this project in the browser
					</span>
					<span class="mt-0.5 block text-xs text-zinc-500">
						Saves the indexed files to localStorage so a refresh or dev reload keeps your
						session. Stays on this device only.
					</span>
				</span>
			</label>
			<p id="atlas-upload-status" class="mt-3 text-sm text-zinc-500" role="status"></p>
			<div id="atlas-warnings" class="mt-2 space-y-2"></div>
		</section>

		<!-- Workspace: left drawer + full-bleed alluvial -->
		<section id="atlas-workspace" class="atlas-workspace hidden min-h-0 flex-1">
			<aside id="atlas-drawer" class="atlas-drawer" aria-label="Repository explorer">
				<!-- Tree panel -->
				<div class="atlas-drawer__panel atlas-drawer__panel--tree">
					<div class="atlas-drawer__head">
						<div class="ui-tile__label mb-0">Repository tree</div>
						<p class="mt-1 text-[0.7rem] leading-snug text-zinc-500">
							Folders expand · click a source file as start
						</p>
					</div>
					<div class="atlas-drawer__tools">
						<input
							id="atlas-tree-filter"
							type="search"
							placeholder="Filter paths…"
							class="atlas-input"
						/>
					</div>
					<div id="atlas-tree" class="atlas-tree" role="tree"></div>
				</div>

				<!-- Catalog panel -->
				<div class="atlas-drawer__panel atlas-drawer__panel--catalog">
					<div class="atlas-drawer__head">
						<div class="ui-tile__label mb-0">Map catalog</div>
						<p id="atlas-catalog-summary" class="mt-1 text-[0.7rem] leading-snug text-zinc-500"></p>
					</div>
					<div class="atlas-drawer__scroll">
						<h2 class="atlas-section-label">Suggested views</h2>
						<div id="atlas-views" class="mb-3"></div>

						<h2 class="atlas-section-label">
							Starts
							<span class="atlas-section-label__hint">· inferred</span>
						</h2>
						<div id="atlas-starts" class="mb-3"></div>

						<h2 class="atlas-section-label">
							Ends
							<span class="atlas-section-label__hint">· packages & sinks</span>
						</h2>
						<div id="atlas-ends"></div>
					</div>
				</div>
			</aside>

			<section class="atlas-stage" aria-label="Alluvial projection">
				<div class="atlas-stage__bar">
					<div class="min-w-0">
						<div class="ui-tile__label mb-0">Alluvial projection</div>
						<p id="atlas-alluvial-caption" class="truncate text-sm text-zinc-400">
							Select a start to project modules → code.
						</p>
					</div>
					<span
						id="atlas-epistemic"
						class="shrink-0 rounded bg-zinc-800 px-2 py-0.5 text-[0.65rem] uppercase tracking-wide text-zinc-400"
					>
						Observed edges
					</span>
				</div>
				<div
					id="atlas-alluvial"
					class="ui-carbon-chart atlas-stage__chart"
					data-carbon-chart="alluvial"
				>
					<!-- holder recreated on each mount (Carbon Charts destroy/reuse safety) -->
				</div>
			</section>
		</section>
	</div>

	<script>
		import '../client/app.ts';
	</script>
</Layout>
