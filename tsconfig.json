{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@shell/*": ["src/shell/*"],
      "@stage/*": ["src/stage/*"],
      "@exact/*": ["src/exact/*"]
    }
  }
}
