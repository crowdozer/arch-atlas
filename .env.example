# -----------------------------------------------------------------------------
# Google Analytics (optional) - same GA4 property as mainframe/sentinel (one dashboard).
# Events carry app=arch-atlas; filter by app or hostname in Explore.
# -----------------------------------------------------------------------------
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# -----------------------------------------------------------------------------
# Vercel - set automatically in deployments (do not add locally)
# Values: production | preview | development
# Used by Analytics for environment tagging.
# -----------------------------------------------------------------------------
# VERCEL_ENV=production
